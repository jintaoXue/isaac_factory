# Copy to .wandb_local.env (gitignored) on shared machines.
# Only affects processes started via ./batch_train.sh — does NOT change
# global `wandb login` / ~/.netrc for other users on the same host.
#
#   cp .wandb_local.env.example .wandb_local.env
#   # fill in key + entity, then:
#   ./batch_train.sh 24 cuda:0

HC_WANDB_API_KEY=
HC_WANDB_ENTITY=
HC_WANDB_MODE=online
